# ==== Бэкенд (только сервер, в браузер не попадает) ====
# Polza.AI — https://polza.ai (Личный кабинет → API-ключи)
POLZA_API_KEY=
POLZA_MODEL=openai/gpt-4o

# Supabase (бесплатный): Project Settings → API
#   SUPABASE_URL = Project URL
#   SUPABASE_SERVICE_ROLE_KEY = service_role (секретный!)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Локально: скопируй этот файл в .env.local и заполни.
# На Vercel: Settings → Environment Variables (те же имена, без префиксов).
